# Ruta local a un GGUF, por ejemplo Qwen3-4B-Instruct Q4_K_M.
LLM_MODEL_PATH=C:\models\Qwen3-4B-Instruct-Q4_K_M.gguf
LLM_CONTEXT_SIZE=6144
LLM_GPU_LAYERS=20

# faster-whisper usa modelos CTranslate2: tiny, base, small o una ruta local.
STT_MODEL=base

# OCR se carga solo para páginas PDF sin texto extraíble.
OCR_ENABLED=true
OCR_USE_GPU=false
OCR_DET_MODEL_DIR=C:\models\paddleocr\det
OCR_REC_MODEL_DIR=C:\models\paddleocr\rec

EDUEVAL_DB_PATH=edueval.sqlite3
